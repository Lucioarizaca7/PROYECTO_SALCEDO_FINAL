{
  "name": "sisrec-salcedo-rentas",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm run dev --workspace apps/server\" \"npm run dev --workspace apps/client\"",
    "dev:server": "npm run dev --workspace apps/server",
    "dev:client": "npm run dev --workspace apps/client",
    "build": "npm run build --workspace apps/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^9.0.1",
    "happy-dom": "^20.14.6",
    "vitest": "^4.1.11"
  }
}
