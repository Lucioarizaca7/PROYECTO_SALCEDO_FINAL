# Copiar a .env.production (no se versiona) y completar. Lo leen docker-compose.prod.yml y la API.

# Dominio público. Debe apuntar (registro DNS A) a la IP del servidor antes de levantar Caddy.
# Para un servidor de pruebas sin dominio se puede usar sslip.io, p. ej. 203-0-113-10.sslip.io
DOMAIN=sisrec.example.pe

# Clave de PostgreSQL (solo se usa dentro de la red interna de Docker).
POSTGRES_PASSWORD=cambiar-por-una-clave-larga

# Secreto de los tokens: mínimo 32 caracteres. Generar con:  openssl rand -hex 48
JWT_SECRET=

# Duración del token de acceso (número = minutos; también acepta "12h", "30m").
JWT_EXPIRES_IN=15
REFRESH_TOKEN_TTL_HOURS=12

BCRYPT_SALT_ROUNDS=12

# Límite general por IP real del usuario y límite de intentos de acceso (ventana de 15 min).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
LOGIN_RATE_LIMIT_MAX=20

# Puertos publicados por Caddy (cambiar solo para probar en una PC que ya usa 80/443).
# HTTP_PORT=80
# HTTPS_PORT=443

# Respaldos diarios (servicio "backup"). Se guardan siempre en el volumen "respaldos" del servidor;
# para tener una copia fuera del servidor (recomendado), completar un bucket S3 compatible
# (DigitalOcean Spaces, Akamai/Linode Object Storage, Backblaze B2…) y darle una regla de 30 días.
BACKUP_RETENCION_DIAS=30
# BACKUP_S3_BUCKET=sisrec-respaldos
# BACKUP_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
