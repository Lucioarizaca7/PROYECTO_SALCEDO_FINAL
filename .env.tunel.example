# Prueba con túnel (docs/prueba-con-tunel.md). Copiar a .env.tunel; no se sube a GitHub.
# SOLO PARA PROBAR: nunca usar este archivo ni docker-compose.tunel.yml en el servidor real.

# Caddy sirve HTTP en el puerto 80 del contenedor para cualquier nombre; el HTTPS lo pone Cloudflare.
DOMAIN=:80

# Puerto de la PC donde queda la web (el túnel apunta aquí). Si 8080 está ocupado, usar otro (8081…).
HTTP_PORT=8080
HTTPS_PORT=8443

# Claves de la base y de las sesiones de esta prueba: cámbielas por cualquier texto largo.
POSTGRES_PASSWORD=cambiar-clave-de-prueba-larga
JWT_SECRET=cambiar-por-un-texto-largo-de-al-menos-32-caracteres

# Todos los celulares llegan por el túnel con la misma IP: se sube el límite de intentos de ingreso.
LOGIN_RATE_LIMIT_MAX=200
