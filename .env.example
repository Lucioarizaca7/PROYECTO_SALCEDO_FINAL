# Copiar a .env (raíz del proyecto) para desarrollo. config.ts lo lee y valida al arrancar.
NODE_ENV=development
PORT=3003

# Origen del cliente permitido por CORS (varios separados por coma).
FRONTEND_URL=http://localhost:5173

# PostgreSQL de desarrollo (docker compose up -d postgres → puerto 5433)
DATABASE_URL=postgresql://sisrec:sisrec_dev@127.0.0.1:5433/sisrec

# Obligatorio. Generar con: openssl rand -hex 48
JWT_SECRET=

# Duración del token (número = minutos; también "12h", "30m")
JWT_EXPIRES_IN=15
BCRYPT_SALT_ROUNDS=10

# Límites por IP (ventana en ms). En desarrollo no se limita el tráfico local.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
LOGIN_RATE_LIMIT_MAX=20

# Proxy delante de la API: 1 = un proxy (Caddy/Nginx). Vacío = ninguno en desarrollo.
# TRUST_PROXY=1

# El cliente (Vite) lee su propio apps/client/.env: VITE_API_URL=http://localhost:3003 (origen, sin /api)
